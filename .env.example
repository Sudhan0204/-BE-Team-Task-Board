# Application Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Option A: Connection URI string (takes precedence over individual params if set)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/devflow_db

# Option B: Individual connection parameters (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devflow_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Authentication & JWT Configuration
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=1h
AUTH_COOKIE_NAME=devflow_token

# Platform Super Admin Authentication (MUST be separate from JWT_SECRET)
SUPER_ADMIN_JWT_SECRET=replace_with_a_different_strong_random_secret_at_least_32_characters
SUPER_ADMIN_JWT_EXPIRES_IN=12h
SUPER_ADMIN_COOKIE_NAME=devflow_super_admin_token
SUPER_ADMIN_EMAIL=superadmin@teamtaskboard.app
SUPER_ADMIN_PASSWORD=change_this_before_seeding

# Email Configuration (for password recovery; leave blank in development to log emails)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="DevFlow Support <no-reply@devflow.app>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# File Upload Directory (relative to backend root)
UPLOAD_DIR=uploads
