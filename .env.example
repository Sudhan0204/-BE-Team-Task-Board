# Application Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Option A: Connection URI string
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres

# Option B: Individual connection parameters (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=root
# DB_SSL=false
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# Authentication & JWT Configuration
JWT_SECRET=super_secret_devflow_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=1d
JWT_RESET_EXPIRES_IN=1h

# Email Configuration (for password recovery)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="DevFlow Support <no-reply@devflow.app>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
