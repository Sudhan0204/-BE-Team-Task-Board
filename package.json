{
  "name": "devflow-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js, Express.js 5, and Knex.js REST API for DevFlow",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed:run": "knex seed:run"
  },
  "keywords": [
    "devflow",
    "express",
    "knex",
    "postgresql",
    "rest-api",
    "task-management"
  ],
  "author": "DevFlow Engineering Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
